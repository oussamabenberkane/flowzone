# FlowZone environment variables
# ------------------------------------------------------------------------------
# HOW TO USE THIS FILE
#   Local development: copy this file to `.env.local` and fill in the values.
#                      `.env.local` is ignored by git and must NEVER be committed.
#   Vercel:            add the same names under Project -> Settings -> Environment
#                      Variables (Production and Preview). Never paste secrets into
#                      the repository, issues, or chat.
#
# CONVENTION FOR EVERYONE WHO ADDS A VARIABLE
#   1. Add it to the schema in `src/server/env.ts` (this is the only place that
#      reads `process.env` for application settings).
#   2. Add it here with a plain-language comment and NO real value.
#   3. Required variables are checked when the server starts; a missing or
#      malformed value stops the app with a clear message (it never prints values).
#   4. Anything that must reach the browser has to start with NEXT_PUBLIC_ and must
#      never be a secret. FlowZone currently has no such variables.
# Blank values are treated as "not set".
# ------------------------------------------------------------------------------


# ---- Database ----------------------------------------------------------------

# REQUIRED. Postgres connection string the app uses at runtime. With Neon, use the
# POOLED string (the host contains "-pooler"). It looks like:
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Use your DEVELOPMENT database branch here for local work, never production.
DATABASE_URL=

# OPTIONAL but recommended. The DIRECT (non-pooled) connection string for the same
# database. Migrations use it because they need a real session. If empty,
# migrations fall back to DATABASE_URL. The Vercel + Neon integration sets this
# automatically.
DATABASE_URL_UNPOOLED=


# ---- Sign-in (Better Auth + Google) -------------------------------------------

# REQUIRED. A long random string (at least 32 characters) that protects sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use a different value for local development and for production.
BETTER_AUTH_SECRET=

# The public address of the app, with no trailing slash. Needed so Google sends
# people back to the right place.
#   Local development:  http://localhost:3000
#   Production:         https://your-production-domain
# On Vercel it is filled in automatically if you leave it blank, but setting it
# explicitly for Production is recommended.
BETTER_AUTH_URL=http://localhost:3000

# REQUIRED. Google OAuth client credentials (Google Cloud Console -> APIs & Services
# -> Credentials -> OAuth client ID -> Web application). The authorized redirect URI
# must be:  <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# REQUIRED. Who may sign in. A comma-separated list of Google account emails.
# Sign-up is closed: anyone not on this list is refused with a friendly message.
# Example: first@example.com,second@example.com
ALLOWED_EMAILS=


# ---- Test-only login (automated tests) ----------------------------------------

# OPTIONAL. Set to "true" ONLY on a developer machine or a test environment to let
# automated tests sign in as named test users without Google. It is refused when
# the deployment is production (the app will not even start in that combination).
# Leave it unset or "false" everywhere else, including Vercel Preview.
ENABLE_TEST_LOGIN=false

# OPTIONAL. Names the kind of environment: development, test, preview or production.
# Normally you do not set this: it is worked out from VERCEL_ENV (on Vercel) or
# NODE_ENV. `npm run build` and `npm start` run with NODE_ENV=production, so on your
# own machine they are treated as PRODUCTION (https required, test login refused).
# To build or start the app locally, put this in your `.env.local`:
#   APP_ENV=development     (or APP_ENV=test for automated tests that need test login)
# Leave it blank on Vercel and on any real server. On Vercel production this value is
# ignored; production always wins.
APP_ENV=


# ---- AI (optional; see docs/contracts/ai.md) -----------------------------------

# Which AI provider the app uses. Leave it as "none" to run FlowZone as a plain todo app
# with no AI at all. Allowed values:
#   none        AI is off for everyone (the default)
#   groq        Groq hosted open models (free tier; the owner must confirm current terms)
#   mistral     Mistral API (see docs/contracts/ai.md: no $0 API tier was confirmed)
#   openrouter  OpenRouter free ":free" models
#   standin     deterministic scripted replies for automated tests. Refused in production.
AI_PROVIDER=none

# REQUIRED when AI_PROVIDER is groq, mistral or openrouter. The provider's API key.
# Create it in the provider's console and paste it into `.env.local` or Vercel only.
AI_API_KEY=

# OPTIONAL. The model name for the chosen provider. Leave blank to use the default for
# that provider (see the AI contract). Required for openrouter.
AI_MODEL=

# OPTIONAL. Most AI requests one person may make per calendar day (their time zone).
# Chat messages and AI feature calls both count. Default 30.
AI_DAILY_REQUEST_LIMIT=30


# ---- Nudges and web push (optional; see docs/contracts/nudges.md) -----------------

# OPTIONAL. The shared secret that the scheduler (GitHub Actions) sends to the tick endpoint,
# in the header x-flowzone-tick-secret. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The same value goes into the GitHub repository secret NUDGE_TICK_SECRET. Blank = the tick
# endpoint does not exist (no nudges are sent).
NUDGE_TICK_SECRET=

# OPTIONAL. Web push keys (VAPID), made once for this app. The three go together, or leave all blank.
# Generate a pair with:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY is shown to the browser (it is not secret). VAPID_PRIVATE_KEY is secret.
# VAPID_SUBJECT is a contact address for the push services, as mailto:you@example.com or an https URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# OPTIONAL, TESTS ONLY. Set to "true" on a developer machine or a test environment to let the tick
# endpoint accept an "as of" time (for deterministic tests of quiet hours and caps). Refused in
# production, and the endpoint answers 404 to it. Never set it on Vercel.
NUDGE_TEST_CLOCK=false


# ---- Set by the platform (do not set these yourself) ---------------------------

# Vercel sets these on its own deployments. Leave them out of .env.local. They are read by
# src/server/env.ts so that a Vercel deployment can work out its address and environment.
#   VERCEL_ENV                      production, preview or development
#   VERCEL_URL                      this deployment's address (no protocol)
#   VERCEL_PROJECT_PRODUCTION_URL   the production address (no protocol)
#   VERCEL                          set to 1 on Vercel (the seed script refuses to run there)
# NODE_ENV is set by Node and Next.js (production for `next build` and `next start`).


# ---- Automated tests only (see docs/testing.md; not used by the app itself) ----

# The Playwright suite needs a LOCAL, disposable Postgres database whose name contains "test"
# (for example flowzone_test). It refuses any other host or name. It runs its own test server
# on E2E_PORT (default 3100). Leave these blank for normal development.
#   E2E_DATABASE_URL=
#   E2E_PORT=3100
#   E2E_PUSH_PORT=3443
# E2E_REUSE_SERVER=1 reuses an already running test server instead of building a new one.
# CI is set by most CI systems; it makes the suite stricter (no focused tests, one retry).
